{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/club/:path*",
      "destination": "https://npjzxcuhenbdzxquralv.supabase.co/functions/v1/club/:path*"
    },
    {
      "source": "/staff/club",
      "destination": "/staff-club"
    },
    {
      "source": "/staff/login",
      "destination": "/staff"
    },
    {
      "source": "/m/:token",
      "destination": "/member"
    }
  ],
  "headers": [
    {
      "source": "/staff",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/staff/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/m/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ]
}
